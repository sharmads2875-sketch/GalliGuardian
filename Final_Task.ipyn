      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "#loading csv file\n",
        "data=pd.read_csv(\"/content/amazon_sales_dataset.csv\")\n",
        "print(data)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
